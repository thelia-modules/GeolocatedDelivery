<?xml version="1.0" encoding="UTF-8"?>
<module xmlns="http://thelia.net/schema/dic/module"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://thelia.net/schema/dic/module http://thelia.net/schema/dic/module/module-2_2.xsd">
    <fullnamespace>GeolocatedDelivery\GeolocatedDelivery</fullnamespace>
    <descriptive locale="en_US">
        <title>Local delivery</title>
        <description>Delivers around your stores, at a price set by the distance between the delivery address and the nearest store.</description>
    </descriptive>
    <descriptive locale="fr_FR">
        <title>Livraison locale</title>
        <description>Livre autour de vos boutiques, à un prix fixé par la distance entre l'adresse de livraison et la boutique la plus proche.</description>
    </descriptive>
    <languages>
        <language>en_US</language>
        <language>fr_FR</language>
    </languages>
