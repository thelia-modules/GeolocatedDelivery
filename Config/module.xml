            <email>tdasilva@openstudio.fr</email>
        </author>
    </authors>
    <type>delivery</type>
    <thelia>3.0.0</thelia>
    <stability>prod</stability>
    <mandatory>0</mandatory>
    <hidden>0</hidden>
</module>
